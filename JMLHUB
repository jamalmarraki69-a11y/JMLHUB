-- Drag
local dragging = false
local dragStart, startPos

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local function createToggle(name, y, default)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -20, 0, 32)
    button.Position = UDim2.fromOffset(10, y)
    button.BackgroundColor3 = Color3.fromRGB(38, 22, 53)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.Parent = main

    local enabled = default

    local function update()
        button.Text = name .. "     " .. (enabled and "ON" or "OFF")
        button.BackgroundColor3 = enabled
            and Color3.fromRGB(95, 35, 145)
            or Color3.fromRGB(38, 22, 53)
    end

    button.MouseButton1Click:Connect(function()
        enabled = not enabled
        update()
    end)

    update()
end

local function createSlider(name, y, initial)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -20, 0, 18)
    label.Position = UDim2.fromOffset(10, y)
    label.BackgroundTransparency = 1
    label.TextColor3 = Color3.new(1, 1, 1)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 12
    label.Text = name .. "     " .. initial
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = main

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(1, -20, 0, 8)
    bar.Position = UDim2.fromOffset(10, y + 22)
    bar.BackgroundColor3 = Color3.fromRGB(65, 42, 80)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = main

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(initial / 100, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(190, 65, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar

    local function setValue(x)
        local percent = math.clamp(
            (x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
            0, 1
        )
        local value = math.floor(percent * 100 + 0.5)
        fill.Size = UDim2.fromScale(percent, 1)
        label.Text = name .. "     " .. value
    end

    bar.Activated:Connect(function()
        setValue(UserInputService:GetMouseLocation().X)
    end)
end

